rules_version = '2';

// S10 · Firestore
// Cada repartidor sólo puede leer/escribir su propio documento de presencia
// (drivers/{email}) y los comprobantes de entrega que cuelgan de él.
service cloud.firestore {
  match /databases/{database}/documents {

    match /drivers/{driverKey} {
      allow read, write: if request.auth != null
        && (request.auth.uid == driverKey
            || request.auth.token.email == driverKey);

      match /deliveries/{orderId} {
        allow read, write: if request.auth != null
          && (request.auth.uid == driverKey
              || request.auth.token.email == driverKey);
      }
    }

    // Todo lo demás queda cerrado por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
